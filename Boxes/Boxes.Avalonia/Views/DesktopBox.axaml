<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Boxes.Avalonia.Views.DesktopBox"
        Title="Desktop Box"
        Width="400"
        Height="300"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True">

    <ExperimentalAcrylicBorder x:Name="GlassBorder"
                               CornerRadius="8"
                               IsHitTestVisible="True">
        <ExperimentalAcrylicBorder.Material>
            <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                        TintColor="Black"
                                        TintOpacity="0.15"
                                        MaterialOpacity="0.8"/>
        </ExperimentalAcrylicBorder.Material>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Drag Area / Title Bar -->
            <Grid Grid.Row="0" x:Name="DragArea" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="BoxTitleTextBlock"
                           Text="Desktop Box"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="12,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Close this box"/>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="Transparent" Margin="8,0,8,8">
                <Grid>
                    <!-- Drop zone for files -->
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="2"
                            CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="&#xE7C1;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBlock Text="Drop files here"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBlock Text="or use the tray icon to organize"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ExperimentalAcrylicBorder>
</Window>
