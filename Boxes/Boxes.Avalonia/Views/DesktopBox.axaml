<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Boxes.Avalonia.Views.DesktopBox"
        Title="Desktop Box"
        Width="400"
        Height="300"
        WindowStartupLocation="Manual"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True">

    <!-- OUTER RIM (acetate frame) -->
    <Border x:Name="AcetateBorder"
            CornerRadius="12"
            Background="Transparent">

        <!-- INNER RIM + CONTENT -->
        <Grid Background="Transparent" ClipToBounds="True">

            <!-- INNER RIM (inset stroke only; spacing = frame thickness feel) -->
            <Border x:Name="InnerRing"
                    Margin="10"
                    CornerRadius="10"
                    Background="Transparent" />

            <!-- CONTENT AREA (kept, perfectly clear) -->
            <Grid x:Name="ContentGrid" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drag Area / Title Bar -->
                <Grid Grid.Row="0"
                      x:Name="DragArea"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="BoxTitleTextBlock"
                               Text="Desktop Box"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="12,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF000000"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CloseButton"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Click="CloseButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="#FF000000"
                                ToolTip.Tip="Close this box"/>
                    </StackPanel>
                </Grid>

                <!-- Drop zone (kept for structure; visually invisible to keep center crystal-clear) -->
                <Border Grid.Row="1"
                        x:Name="DropZone"
                        Background="Transparent"
                        Margin="8,0,8,8"
                        BorderThickness="2"
                        CornerRadius="6"
                        BorderBrush="#00FFFFFF">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="&#xE7C1;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="#00000000"/>
                        <TextBlock Text="Drop files here"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#00000000"/>
                        <TextBlock Text="or use the tray icon to organize"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#00000000"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
