<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
        x:Class="Boxes.Avalonia.Views.DesktopBox"
        Title="Desktop Box"
        Width="400"
        Height="300"
        WindowStartupLocation="Manual"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True">

    <!-- NOTE: Backdrop acrylic is not available on your current Avalonia.
         When you upgrade, you can re-enable this block and the donut path below.

    <Window.Resources>
        <AcrylicMaterial x:Key="GapAcrylic"
                         BackgroundSource="Backdrop"
                         TintColor="#E6F7FF"
                         TintOpacity="0.06"
                         MaterialOpacity="0.18"
                         EnableNoise="False"/>
    </Window.Resources>
    -->

    <!-- OUTER RIM (acetate frame) -->
    <Border x:Name="AcetateBorder"
            CornerRadius="12"
            Background="Transparent">

        <!-- LAYER STACK -->
        <Grid Background="Transparent" ClipToBounds="True">

            <!-- GAP FILL (stroke-only ring). Geometry is set in code so it sits
                 exactly between the two lines and hugs the corners. -->
            <shapes:Rectangle x:Name="RingFill"
                              Margin="0"
                              RadiusX="12" RadiusY="12"
                              Fill="Transparent"
                              StrokeThickness="18"
                              IsHitTestVisible="False">
                <shapes:Rectangle.Stroke>
                    <!-- subtle “clear acetate” tint; updated in code too -->
                    <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                        <GradientStop Color="#22F5FAFF" Offset="0.00"/>
                        <GradientStop Color="#10FFFFFF" Offset="0.35"/>
                        <GradientStop Color="#0CFFFFFF" Offset="0.65"/>
                        <GradientStop Color="#18F5FAFF" Offset="1.00"/>
                    </LinearGradientBrush>
                </shapes:Rectangle.Stroke>
            </shapes:Rectangle>

            <!-- If acrylic becomes available, uncomment this donut and the code-behind.
            <shapes:Path x:Name="GapAcrylicPath"
                         Fill="{StaticResource GapAcrylic}"
                         StrokeThickness="0"
                         IsHitTestVisible="False"/>
            -->

            <!-- INNER RIM (visible line only; Margin controls frame thickness) -->
            <Border x:Name="InnerRing"
                    Margin="10"
                    CornerRadius="10"
                    Background="Transparent" />

            <!-- CONTENT AREA (kept, perfectly clear) -->
            <Grid x:Name="ContentGrid" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drag Area / Title Bar -->
                <Grid Grid.Row="0"
                      x:Name="DragArea"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="BoxTitleTextBlock"
                               Text="Desktop Box"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="12,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF000000"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CloseButton"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Click="CloseButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="#FF000000"
                                ToolTip.Tip="Close this box"/>
                    </StackPanel>
                </Grid>

                <!-- Drop zone (kept; invisible so center stays crystal clear) -->
                <Border Grid.Row="1"
                        x:Name="DropZone"
                        Background="Transparent"
                        Margin="8,0,8,8"
                        BorderThickness="2"
                        CornerRadius="6"
                        BorderBrush="#00FFFFFF">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="&#xE7C1;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="#00000000"/>
                        <TextBlock Text="Drop files here"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#00000000"/>
                        <TextBlock Text="or use the tray icon to organize"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#00000000"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
