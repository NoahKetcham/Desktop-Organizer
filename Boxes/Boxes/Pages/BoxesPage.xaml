<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boxes.Pages.BoxesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,32">
            <TextBlock
                Text="Desktop Boxes"
                FontSize="32"
                FontWeight="Bold"/>
            <TextBlock
                Text="Create and manage desktop containers to organize your files"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Create New Box Section -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE710;"
                    FontSize="24"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Text="Create New Box"
                        FontSize="16"
                        FontWeight="SemiBold"/>
                    <TextBlock
                        Text="Add a new container to your desktop"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBox
                    x:Name="NewBoxNameTextBox"
                    Grid.Column="2"
                    Text="My New Box"
                    PlaceholderText="Box name..."
                    Width="160"
                    Margin="16,0,8,0"/>

                <ComboBox
                    x:Name="StyleComboBox"
                    Grid.Column="3"
                    SelectedIndex="0"
                    Width="150"
                    Margin="0,0,8,0">
                    <ComboBoxItem Content="Windows (Mica)"/>
                    <ComboBoxItem Content="Acetate (Clear)"/>
                    <ComboBoxItem Content="Solid"/>
                    <ComboBoxItem Content="Acrylic (Blur)"/>
                    <ComboBoxItem Content="Minimal"/>
                    <ComboBoxItem Content="Frosted"/>
                </ComboBox>

                <Button
                    Grid.Column="4"
                    Content="Add New Box"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="AddNewBoxButton_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter"/>
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>
        </Border>

        <!-- Boxes List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Quick Actions -->
                <Border
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Quick Actions"
                            FontSize="14"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="1"
                            Content="Show All"
                            Click="ShowAllButton_Click"
                            Margin="0,0,8,0"/>

                        <Button
                            Grid.Column="2"
                            Content="Hide All"
                            Click="HideAllButton_Click"/>
                    </Grid>
                </Border>

                <!-- Boxes Grid -->
                <ItemsControl x:Name="BoxesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Width="320"
                                Height="240"
                                Margin="0,0,16,16">

                                <Grid Padding="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="12"
                                            Margin="0,0,16,0">
                                            <FontIcon
                                                Glyph="&#xE7B8;"
                                                FontSize="24"
                                                Foreground="White"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="BoxNameInCard"
                                                Text="Box Name"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock
                                                x:Name="BoxFileCountInCard"
                                                Text="0 files"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Stats -->
                                    <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="Total Size"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock
                                                x:Name="BoxSizeInCard"
                                                Grid.Column="1"
                                                Text="0 B"
                                                FontSize="12"
                                                FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="Status"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Border
                                                Grid.Column="1"
                                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                CornerRadius="4"
                                                Padding="6,2">
                                                <TextBlock
                                                    x:Name="BoxStatusInCard"
                                                    Text="Hidden"
                                                    FontSize="11"
                                                    Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            x:Name="BoxDescriptionInCard"
                                            Text="Description"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Content="Show on Desktop"
                                            HorizontalAlignment="Stretch"
                                            Click="ShowBoxButton_Click"/>

                                        <Button
                                            Content="&#xE70F;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Padding="10"
                                            ToolTipService.ToolTip="Edit"
                                            Click="EditBoxButton_Click"/>

                                        <Button
                                            Content="&#xE74D;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Padding="10"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            ToolTipService.ToolTip="Delete"
                                            Click="DeleteBoxButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
