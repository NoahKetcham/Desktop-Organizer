<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boxes.Pages.BoxesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Boxes.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Page.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Page.Resources>

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,32">
            <TextBlock
                Text="Desktop Boxes"
                FontSize="32"
                FontWeight="Bold"/>
            <TextBlock
                Text="Create and manage desktop containers to organize your files"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Create New Box Section -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24"
                Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE710;"
                        FontSize="24"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="Create New Box"
                            FontSize="16"
                            FontWeight="SemiBold"/>
                        <TextBlock
                            Text="Add a new container to your desktop"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Live Preview Toggle -->
                    <ToggleButton
                        x:Name="PreviewToggleButton"
                        Grid.Column="2"
                        Content="&#xE7B3;"
                        FontFamily="Segoe MDL2 Assets"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Width="40"
                        Height="32"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Toggle live preview"
                        IsChecked="False"
                        Checked="PreviewToggleButton_Checked"
                        Unchecked="PreviewToggleButton_Unchecked"/>
                </Grid>

                <!-- Controls Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="NewBoxNameTextBox"
                        Grid.Column="0"
                        Text="My New Box"
                        PlaceholderText="Box name..."
                        Width="160"
                        Margin="0,0,8,0"/>

                    <ComboBox
                        x:Name="StyleComboBox"
                        Grid.Column="1"
                        SelectedIndex="0"
                        Width="150"
                        Margin="0,0,8,0">
                        <ComboBoxItem Content="Windows (Mica)"/>
                        <ComboBoxItem Content="Acetate (Clear)"/>
                        <ComboBoxItem Content="Solid"/>
                        <ComboBoxItem Content="Acrylic (Blur)"/>
                        <ComboBoxItem Content="Minimal"/>
                        <ComboBoxItem Content="Frosted"/>
                    </ComboBox>

                    <ComboBox
                        x:Name="ColorComboBox"
                        Grid.Column="2"
                        SelectedIndex="0"
                        Width="120"
                        Margin="0,0,8,0">
                        <ComboBoxItem Content="Blue"/>
                        <ComboBoxItem Content="Purple"/>
                        <ComboBoxItem Content="Green"/>
                        <ComboBoxItem Content="Red"/>
                        <ComboBoxItem Content="Orange"/>
                        <ComboBoxItem Content="Teal"/>
                    </ComboBox>

                    <Slider
                        x:Name="OpacitySlider"
                        Grid.Column="3"
                        Header="Opacity"
                        Value="95"
                        Minimum="30"
                        Maximum="100"
                        Width="100"
                        Margin="0,0,8,0"
                        ValueChanged="OpacitySlider_ValueChanged"/>

                    <Button
                        Grid.Column="4"
                        Content="Add New Box"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="AddNewBoxButton_Click"
                        IsEnabled="{x:Bind PreviewToggleButton.IsChecked, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Live Preview Section -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0"
                Margin="0,0,0,24"
                Visibility="{x:Bind PreviewToggleButton.IsChecked, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <Border Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Desktop Preview"
                            FontSize="14"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="Scale:"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"/>

                            <ComboBox
                                x:Name="PreviewScaleComboBox"
                                SelectedIndex="1"
                                Width="80">
                                <ComboBoxItem Content="25%"/>
                                <ComboBoxItem Content="50%"/>
                                <ComboBoxItem Content="75%"/>
                                <ComboBoxItem Content="100%"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Preview Canvas -->
                <Border Grid.Row="1"
                        Background="#F8F8F8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ZoomMode="Enabled">
                        <Canvas x:Name="DesktopPreviewCanvas"
                                Width="1200"
                                Height="800"
                                Background="Transparent">
                            <!-- Desktop background representation -->
                            <Border Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="1200"
                                    Height="800"
                                    Background="#E6E6E6"
                                    CornerRadius="8"/>

                            <!-- Sample desktop icons -->
                            <Border Canvas.Left="50"
                                    Canvas.Top="50"
                                    Width="60"
                                    Height="80"
                                    Background="#4CAF50"
                                    CornerRadius="4"/>
                            <TextBlock Canvas.Left="50"
                                       Canvas.Top="140"
                                       Text="Icon 1"
                                       FontSize="10"
                                       Foreground="#333"
                                       HorizontalAlignment="Center"/>

                            <Border Canvas.Left="150"
                                    Canvas.Top="50"
                                    Width="60"
                                    Height="80"
                                    Background="#2196F3"
                                    CornerRadius="4"/>
                            <TextBlock Canvas.Left="150"
                                       Canvas.Top="140"
                                       Text="Icon 2"
                                       FontSize="10"
                                       Foreground="#333"
                                       HorizontalAlignment="Center"/>

                            <!-- Preview box representation -->
                            <Border x:Name="PreviewBoxBorder"
                                    Canvas.Left="300"
                                    Canvas.Top="200"
                                    Width="200"
                                    Height="150"
                                    BorderBrush="#0078D4"
                                    BorderThickness="2"
                                    CornerRadius="16">
                                <Border.Background>
                                    <SolidColorBrush Color="#E3F2FD" Opacity="0.8"/>
                                </Border.Background>
                                <TextBlock Text="📦 Preview Box"
                                           FontSize="12"
                                           Foreground="#0078D4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Canvas>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Boxes List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Quick Actions -->
                <Border
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Quick Actions"
                            FontSize="14"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="1"
                            Content="Show All"
                            Click="ShowAllButton_Click"
                            Margin="0,0,8,0"/>

                        <Button
                            Grid.Column="2"
                            Content="Hide All"
                            Click="HideAllButton_Click"/>
                    </Grid>
                </Border>

                <!-- Boxes Grid -->
                <ItemsControl x:Name="BoxesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="BoxCardBorder"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Width="340"
                                    Height="260"
                                    Margin="0,0,16,16">


                                <Grid Padding="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header with enhanced styling -->
                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status indicator -->
                                        <Border
                                            Grid.Column="0"
                                            Width="12"
                                            Height="12"
                                            CornerRadius="6"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush x:Name="StatusIndicator" Color="#FF6B6B"/>
                                            </Border.Background>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="VisibilityStates">
                                                    <VisualState x:Name="Hidden">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="StatusIndicator"
                                                                            Storyboard.TargetProperty="(SolidColorBrush.Color)"
                                                                            To="#FF6B6B"
                                                                            Duration="0"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Visible">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="StatusIndicator"
                                                                            Storyboard.TargetProperty="(SolidColorBrush.Color)"
                                                                            To="#00C851"
                                                                            Duration="0"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>

                                        <!-- Enhanced icon with gradient background -->
                                        <Border
                                            Grid.Column="0"
                                            Width="56"
                                            Height="56"
                                            CornerRadius="14"
                                            Margin="0,0,16,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0078D4" Offset="0"/>
                                                    <GradientStop Color="#40E0D0" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <FontIcon
                                                Glyph="&#xE7B8;"
                                                FontSize="28"
                                                Foreground="White"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="BoxNameInCard"
                                                Text="Box Name"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock
                                                x:Name="BoxSubtitleInCard"
                                                Text="Description"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Margin="0,2,0,0"
                                                TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Quick actions menu -->
                                        <Button
                                            Grid.Column="2"
                                            Content="&#xE712;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Background="Transparent"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            BorderThickness="0"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="More options">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Show on Desktop" Icon="Play"/>
                                                    <MenuFlyoutItem Text="Edit" Icon="Edit"/>
                                                    <MenuFlyoutItem Text="Duplicate" Icon="Copy"/>
                                                    <MenuFlyoutSeparator/>
                                                    <MenuFlyoutItem Text="Delete" Icon="Delete" Foreground="#E74856"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <!-- Enhanced stats section -->
                                    <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                                        <!-- File count with icon -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="&#xE8B7;"
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="Files"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                x:Name="BoxFileCountInCard"
                                                Grid.Column="2"
                                                Text="0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Size info with icon -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="&#xE9A5;"
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="Size"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                x:Name="BoxSizeInCard"
                                                Grid.Column="2"
                                                Text="0 B"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Status with enhanced styling -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="&#xE73E;"
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="Status"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center"/>

                                            <Border
                                                x:Name="StatusBadge"
                                                Grid.Column="2"
                                                CornerRadius="8"
                                                Padding="8,4"
                                                VerticalAlignment="Center">
                                                <Border.Background>
                                                    <SolidColorBrush x:Name="StatusBackground" Color="#FF6B6B"/>
                                                </Border.Background>
                                                <TextBlock
                                                    x:Name="BoxStatusInCard"
                                                    Text="Hidden"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <!-- Description with better styling -->
                                        <Border
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,4,0,0">
                                            <TextBlock
                                                x:Name="BoxDescriptionInCard"
                                                Text="No description available"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                MaxLines="2"
                                                TextTrimming="CharacterEllipsis"
                                                LineHeight="16"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Enhanced actions section -->
                                    <Grid Grid.Row="2" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Primary action -->
                                        <Button
                                            x:Name="ShowHideButton"
                                            Grid.Column="0"
                                            Content="Show on Desktop"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            CornerRadius="8"
                                            Height="36"
                                            HorizontalAlignment="Stretch"
                                            Click="ShowBoxButton_Click"/>

                                        <!-- Secondary actions -->
                                        <Button
                                            Grid.Column="1"
                                            Content="&#xE70F;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Background="Transparent"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="8"
                                            Margin="8,0,0,0"
                                            ToolTipService.ToolTip="Edit box"
                                            Click="EditBoxButton_Click">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="E" Modifiers="Control"/>
                                            </Button.KeyboardAccelerators>
                                        </Button>

                                        <Button
                                            Grid.Column="2"
                                            Content="&#xE74D;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Background="Transparent"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                            BorderThickness="1"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="8"
                                            ToolTipService.ToolTip="Delete box"
                                            Click="DeleteBoxButton_Click">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="Delete"/>
                                            </Button.KeyboardAccelerators>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
