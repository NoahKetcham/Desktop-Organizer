<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boxes.Pages.OrganizationMethodsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Boxes.Pages"
    xmlns:controls="using:Boxes.Controls"
    xmlns:models="using:Boxes.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="32" MaxWidth="1200">

            <!-- Header -->
            <StackPanel Spacing="12">
                <TextBlock 
                    Text="Organization Methods"
                    Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock 
                    Text="Choose how you want to organize your files. Enable multiple methods to keep your desktop tidy automatically."
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Active Methods -->
            <StackPanel Spacing="16">
                <Grid>
                    <TextBlock 
                        Text="Active Methods"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="Apply All" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Configure"/>
                    </StackPanel>
                </Grid>

                <!-- Methods Grid -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.OrganizationMethods}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid 
                                Orientation="Horizontal" 
                                MaximumRowsOrColumns="3"
                                HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:OrganizationMethod">
                            <controls:OrganizationMethodCard 
                                Method="{x:Bind}"
                                CardClicked="OrganizationMethodCard_Click"
                                Margin="0,0,16,16"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Info Section -->
            <Border 
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="24"
                Opacity="0.1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon 
                            Glyph="&#xE946;"
                            FontSize="20"
                            Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                        <TextBlock 
                            Text="Pro Tip"
                            FontWeight="SemiBold"
                            FontSize="16"/>
                    </StackPanel>
                    <TextBlock 
                        Text="You can enable multiple organization methods at once. They'll work together to keep your desktop organized. For example, combine 'By File Type' with 'By Date' to create dated folders for each file type."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
