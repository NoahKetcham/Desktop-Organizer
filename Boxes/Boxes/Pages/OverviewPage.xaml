<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boxes.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Boxes.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="32" MaxWidth="1200">

            <!-- Hero Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center">
                    <TextBlock 
                        Text="{x:Bind ViewModel.WelcomeMessage, Mode=OneWay}"
                        FontSize="40"
                        FontWeight="Bold"/>
                    <TextBlock 
                        Text="Transform your cluttered desktop into an organized workspace. Automate file organization with smart rules, templates, and categories."
                        FontSize="16"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxWidth="500"
                        HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button 
                            Content="Get Started" 
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="20,10"
                            Click="BrowseTemplates_Click"/>
                        <Button 
                            Content="Scan Desktop"
                            Padding="20,10"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hero Icon -->
                <Viewbox Grid.Column="1" Width="200" Height="200" Margin="32,0,0,0">
                    <FontIcon 
                        Glyph="&#xE8F1;" 
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.2"/>
                </Viewbox>
            </Grid>

            <!-- Stats Overview -->
            <Border 
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon 
                            Glyph="&#xE8F4;" 
                            FontSize="32"
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            Text="0"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            Text="Files Organized"
                            FontSize="13"
                            Foreground="White"
                            Opacity="0.9"
                            HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon 
                            Glyph="&#xE71C;" 
                            FontSize="32"
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            Text="0"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            Text="Active Rules"
                            FontSize="13"
                            Foreground="White"
                            Opacity="0.9"
                            HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon 
                            Glyph="&#xE8F7;" 
                            FontSize="32"
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            Text="0"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            Text="Categories"
                            FontSize="13"
                            Foreground="White"
                            Opacity="0.9"
                            HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon 
                            Glyph="&#xE9F9;" 
                            FontSize="32"
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            Text="0 MB"
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            Text="Space Managed"
                            FontSize="13"
                            Foreground="White"
                            Opacity="0.9"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Features Showcase -->
            <StackPanel Spacing="20">
                <TextBlock 
                    Text="What Boxes Can Do"
                    Style="{StaticResource TitleTextBlockStyle}"/>
                
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Feature 1: Smart Rules -->
                    <Border 
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                        <StackPanel Spacing="12">
                            <Border 
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Width="48"
                                Height="48"
                                CornerRadius="24">
                                <FontIcon 
                                    Glyph="&#xE73E;" 
                                    FontSize="24"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock 
                                Text="Smart Rules"
                                FontSize="18"
                                FontWeight="SemiBold"/>
                            <TextBlock 
                                Text="Create intelligent rules to automatically sort files by type, date, name, or custom criteria."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Feature 2: Templates -->
                    <Border 
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                        <StackPanel Spacing="12">
                            <Border 
                                Background="#8B5CF6"
                                Width="48"
                                Height="48"
                                CornerRadius="24">
                                <FontIcon 
                                    Glyph="&#xE71D;" 
                                    FontSize="24"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock 
                                Text="Ready Templates"
                                FontSize="18"
                                FontWeight="SemiBold"/>
                            <TextBlock 
                                Text="Start quickly with pre-designed templates for work, creative projects, development, and more."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Feature 3: Categories -->
                    <Border 
                        Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                        <StackPanel Spacing="12">
                            <Border 
                                Background="#10B981"
                                Width="48"
                                Height="48"
                                CornerRadius="24">
                                <FontIcon 
                                    Glyph="&#xE8F7;" 
                                    FontSize="24"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock 
                                Text="Custom Categories"
                                FontSize="18"
                                FontWeight="SemiBold"/>
                            <TextBlock 
                                Text="Organize files into meaningful categories that match your workflow and keep everything tidy."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Getting Started -->
            <StackPanel Spacing="20">
                <TextBlock 
                    Text="Get Started in 3 Steps"
                    Style="{StaticResource TitleTextBlockStyle}"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 -->
                    <Border 
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock 
                                Text="1"
                                FontSize="48"
                                FontWeight="Bold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock 
                                Text="Choose a Template"
                                FontSize="18"
                                FontWeight="SemiBold"/>
                            <TextBlock 
                                Text="Browse our library of templates or create your own custom setup."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button 
                                Content="Browse Templates"
                                HorizontalAlignment="Left"
                                Click="BrowseTemplates_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 -->
                    <Border 
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock 
                                Text="2"
                                FontSize="48"
                                FontWeight="Bold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock 
                                Text="Scan Your Desktop"
                                FontSize="18"
                                FontWeight="SemiBold"/>
                            <TextBlock 
                                Text="Let Boxes analyze your files and suggest the best organization strategy."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button 
                                Content="Scan Now"
                                HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3 -->
                    <Border 
                        Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock 
                                Text="3"
                                FontSize="48"
                                FontWeight="Bold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock 
                                Text="Automate &amp; Relax"
                                FontSize="18"
                                FontWeight="SemiBold"/>
                            <TextBlock 
                                Text="Watch as your desktop stays organized automatically with smart rules."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button 
                                Content="View Rules"
                                HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Recent Activity (Compact) -->
            <Border 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock 
                            Text="Recent Activity"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            VerticalAlignment="Center"/>
                        <HyperlinkButton 
                            Content="View All"
                            HorizontalAlignment="Right"/>
                    </Grid>
                    <Border 
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="20"
                        MinHeight="100">
                        <StackPanel 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon 
                                Glyph="&#xE9F3;"
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock 
                                Text="No activity yet"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock 
                                Text="Start organizing to see your activity here"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
