<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Boxes.Windows.BoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Outer glossy border -->
        <Border x:Name="OuterGlassBorder"
                CornerRadius="20"
                BorderThickness="4"
                Margin="6">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E8FFFFFF" Offset="0"/>
                    <GradientStop Color="#80FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#E8FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <!-- Inner translucent card area with sheen -->
            <Border x:Name="RootGrid" CornerRadius="16" Margin="6" BorderThickness="0">
                <Grid>
                    <!-- Translucent glass fill with radial sheen -->
                    <Grid.Background>
                        <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="1.0" RadiusY="1.0">
                            <GradientStop Color="#30FFFFFF" Offset="0"/>
                            <GradientStop Color="#14FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#06FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>

                    <!-- Double inner strokes for the crisp glass edge -->
                    <Border CornerRadius="14" BorderThickness="2" BorderBrush="#B0FFFFFF" Margin="12"/>
                    <Border CornerRadius="14" BorderThickness="1" BorderBrush="#60FFFFFF" Margin="18"/>

                    <!-- Drag region for title bar integration -->
                    <Grid x:Name="DragArea" Height="32" VerticalAlignment="Top" Background="Transparent"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>

