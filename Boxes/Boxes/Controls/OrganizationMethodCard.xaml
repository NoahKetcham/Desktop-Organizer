<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Boxes.Controls.OrganizationMethodCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Boxes.Controls"
    xmlns:models="using:Boxes.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border 
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="0"
        MinWidth="300"
        MaxWidth="350">
        
        <Button 
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Click="CardButton_Click"
            CornerRadius="12">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Icon -->
                <Grid Grid.Row="0" Padding="20,20,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Circle -->
                    <Border 
                        Grid.Column="0"
                        Background="{x:Bind Method.AccentColor, Mode=OneWay}"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        VerticalAlignment="Center">
                        <FontIcon 
                            Glyph="{x:Bind Method.IconGlyph, Mode=OneWay}"
                            FontSize="24"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock 
                            Text="{x:Bind Method.Name, Mode=OneWay}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"/>
                        <TextBlock 
                            Text="{x:Bind GetMethodTypeText(Method.Type), Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Enable Toggle -->
                    <ToggleSwitch 
                        Grid.Column="2"
                        IsOn="{x:Bind Method.IsEnabled, Mode=TwoWay}"
                        OnContent=""
                        OffContent=""
                        MinWidth="40"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Description -->
                <StackPanel Grid.Row="1" Padding="20,0,20,16" Spacing="12">
                    <TextBlock 
                        Text="{x:Bind Method.Description, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="13"
                        MaxLines="3"
                        TextTrimming="CharacterEllipsis"/>

                    <!-- File Types -->
                    <ItemsControl ItemsSource="{x:Bind Method.SupportedFileTypes, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border 
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,4">
                                    <TextBlock 
                                        Text="{x:Bind}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Footer with Stats -->
                <Border 
                    Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    Padding="20,12"
                    CornerRadius="0,0,12,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon 
                                Glyph="&#xE8F4;"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock 
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind Method.FilesAffected, Mode=OneWay}"/>
                                <Run Text="files will be organized"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <FontIcon 
                            Glyph="&#xE76C;"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Button>
    </Border>
</UserControl>
